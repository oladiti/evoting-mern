# copy to .env and fill in real values
NODE_ENV=development
PORT=5000
CLIENT_URL=https://localhost:5173
# https://localhost:5173 must be listed: the dev server is HTTPS-only (basicSsl),
# and csrf.js rejects any mutating request whose Origin is not in this list, so
# omitting it makes every POST - register included - fail with "Origin not allowed".
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,https://ejournal.ogitech.edu.ng
JWT_SECRET=
# REQUIRED in production, minimum 32 characters - the server refuses to start
# without it, because the development fallback is a public string and would let
# anyone forge an admin session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES=30m
REMEMBER_EXPIRES=30d
SITE_NAME=E-Voting System

# Content-Security-Policy: report-only | enforce | off
# Start on report-only. Violations are POSTed to /api/csp-report and logged
# server-side as "[csp] ..." lines on stderr - with no report-uri, report-only
# tells you nothing unless a human happens to be watching devtools, which is
# worse than not having the phase at all because it reads like a safety net that
# is not there. Nothing is blocked in report-only, so a too-strict directive
# cannot break reCAPTCHA or the face camera. Once the log is clean across every
# feature, set 'enforce' to actually apply the policy.
#
# The directives live in src/config/csp.js, which also feeds the Vite dev server
# and `npm run csp:emit` (for when something other than this API serves the page).
CSP_MODE=report-only

# MongoDB Atlas connection string (replace <db_password>)
DB_URI=mongodb+srv://USER:HONESTY4REAL@CLUSTER.mongodb.net/evoting?retryWrites=true&w=majority

# MySQL source (for migration script only)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=evoting

# SMTP (Gmail app password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=

# reCAPTCHA v2
# If recaptcha_enabled is ON in Admin > Settings and these are blank, the server
# REJECTS register / login / reset / vote with a 503 and logs a warning. That is
# deliberate: a missing key used to silently disable the captcha while the
# settings screen still showed it as on.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Only set to true to keep serving traffic during a captcha outage, at the cost
# of running register/login/vote with no bot protection. Logs loudly on every use.
RECAPTCHA_FAIL_OPEN=false

# Geofence defaults
GEOFENCE_LAT=6.5438
GEOFENCE_LNG=3.1183
GEOFENCE_RADIUS=1500